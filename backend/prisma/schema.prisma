generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  RENTER
  LISTER
  ADMIN
  MANAGER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_SUBMITTED
}

enum BookingStatus {
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
  CLOSED
}

enum DepositStatus {
  HELD
  RELEASED_TO_RENTER
  RELEASED_TO_LISTER
  PARTIALLY_RELEASED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  PAYHERE
  IPAY
  STRIPE
}

enum ConditionPhotoParty {
  OWNER
  RENTER
}

enum ConditionPhotoType {
  PICKUP
  RETURN
}

enum DisputeStatus {
  RAISED
  UNDER_REVIEW
  RESOLVED
  ESCALATED
  CLOSED
}

enum DisputeOutcome {
  FAVOUR_RENTER
  FAVOUR_LISTER
  SPLIT
  NO_ACTION
}

enum BadgeCategory {
  PAID
  EARNED
}

enum BadgeType {
  TOP_RATED
  VERIFIED_ITEM
  FAST_RESPONDER
  SPONSORED
  FEATURED
}

enum ListingStatus {
  ACTIVE
  PAUSED
  PENDING_REVIEW
  REJECTED
  ARCHIVED
}

enum SubscriptionTier {
  BASIC
  PRO
  PREMIUM
}

enum DepositAuditAction {
  HELD
  RELEASED_TO_RENTER
  RELEASED_TO_LISTER
  PARTIALLY_RELEASED
  DISPUTED
  SYSTEM_AUTO_RELEASED
  ADMIN_MANUAL_RELEASE
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_APPROVED
  BOOKING_DECLINED
  RENTAL_STARTING
  RENTAL_ENDING
  DEPOSIT_RELEASED
  DISPUTE_RAISED
  DISPUTE_RESOLVED
  REVIEW_REQUESTED
  ID_VERIFICATION_APPROVED
  ID_VERIFICATION_REJECTED
  MESSAGE_RECEIVED
  PAYMENT_RECEIVED
  REFERRAL_CONVERTED
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  COMMERCIAL
  LAND
}

enum PropertyStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String?
  name               String
  phone              String?
  avatarUrl          String?
  role               UserRole           @default(RENTER)
  verificationStatus VerificationStatus @default(NOT_SUBMITTED)
  idDocumentFront    String?
  idDocumentBack     String?
  isActive           Boolean            @default(true)
  tosAccepted        Boolean            @default(false)
  tosAcceptedAt      DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  listings           Listing[]
  rentedBookings     Booking[]          @relation("RenterBookings")
  badges             UserBadge[]
  reviewsGiven       Review[]           @relation("ReviewsGiven")
  reviewsReceived    Review[]           @relation("ReviewsReceived")
  messagesSent       Message[]
  notifications      Notification[]
  referralCode       ReferralCode?
  referredBy         String?
  contactReveals     ContactRevealed[]
  ownedProperties    Property[]         @relation("PropertyOwner")
  managedProperties  Property[]         @relation("PropertyManager")
  subscription       Subscription?
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  icon      String
  isEnabled Boolean   @default(false)
  sortOrder Int       @default(0)
  listings  Listing[]
  createdAt DateTime  @default(now())
}

model Listing {
  id               String        @id @default(uuid())
  title            String
  slug             String        @unique
  description      String
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  ownerId          String
  owner            User          @relation(fields: [ownerId], references: [id])
  dailyRate        Int
  depositAmount    Int
  location         String
  lat              Float?
  lng              Float?
  status           ListingStatus @default(PENDING_REVIEW)
  photos           ListingPhoto[]
  badges           ListingBadge[]
  bookings         Booking[]
  averageRating    Float         @default(0)
  reviewCount      Int           @default(0)
  viewCount        Int           @default(0)
  isDraft          Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model ListingPhoto {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  r2Key     String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model UserBadge {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  type       BadgeType
  category   BadgeCategory
  awardedAt  DateTime    @default(now())
  expiresAt  DateTime?
  @@unique([userId, type])
}

model ListingBadge {
  id         String      @id @default(uuid())
  listingId  String
  listing    Listing     @relation(fields: [listingId], references: [id])
  type       BadgeType
  category   BadgeCategory
  awardedAt  DateTime    @default(now())
  expiresAt  DateTime?
  @@unique([listingId, type])
}

model Booking {
  id                String        @id @default(uuid())
  listingId         String
  listing           Listing       @relation(fields: [listingId], references: [id])
  renterId          String
  renter            User          @relation("RenterBookings", fields: [renterId], references: [id])
  startDate         DateTime
  endDate           DateTime
  totalDays         Int
  rentalAmount      Int
  platformFeePercent Float
  platformFeeAmount Int
  depositAmount     Int
  totalCharged      Int
  status            BookingStatus @default(PENDING_APPROVAL)
  depositStatus     DepositStatus @default(HELD)
  cancellationTier  String?
  refundAmount      Int?
  listerCompAmount  Int?
  rentalAgreementKey String?
  conditionPhotos   ConditionPhoto[]
  payments          Payment[]
  depositAuditLogs  DepositAuditLog[]
  messages          Message[]
  dispute           Dispute?
  reviews           Review[]
  contactReveal     ContactRevealed?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model ConditionPhoto {
  id          String              @id @default(uuid())
  bookingId   String
  booking     Booking             @relation(fields: [bookingId], references: [id])
  party       ConditionPhotoParty
  type        ConditionPhotoType
  r2Key       String
  url         String
  uploadedAt  DateTime            @default(now())
  @@unique([bookingId, party, type])
}

model Payment {
  id               String          @id @default(uuid())
  bookingId        String
  booking          Booking         @relation(fields: [bookingId], references: [id])
  provider         PaymentProvider
  status           PaymentStatus   @default(PENDING)
  amount           Int
  currency         String          @default("LKR")
  idempotencyKey   String          @unique
  providerRef      String?
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model DepositAuditLog {
  id          String             @id @default(uuid())
  bookingId   String
  booking     Booking            @relation(fields: [bookingId], references: [id])
  action      DepositAuditAction
  amount      Int
  performedBy String
  note        String?
  createdAt   DateTime           @default(now())
}

model Dispute {
  id          String        @id @default(uuid())
  bookingId   String        @unique
  booking     Booking       @relation(fields: [bookingId], references: [id])
  raisedById  String
  type        String
  description String
  evidenceKeys String[]
  status      DisputeStatus @default(RAISED)
  outcome     DisputeOutcome?
  adminNote   String?
  slaDeadline DateTime
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Review {
  id          String   @id @default(uuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id])
  reviewerId  String
  reviewer    User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId  String
  reviewee    User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  rating      Int
  comment     String
  isBlinded   Boolean  @default(true)
  isFlagged   Boolean  @default(false)
  submittedAt DateTime @default(now())
  windowEndsAt DateTime
  @@unique([bookingId, reviewerId])
}

model Message {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  content   String
  isDeleted Boolean  @default(false)
  isFlagged Boolean  @default(false)
  flagReason String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  actionUrl String?
  createdAt DateTime         @default(now())
}

model ReferralCode {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  code        String   @unique
  invitesSent Int      @default(0)
  converted   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Subscription {
  id           String           @id @default(uuid())
  userId       String           @unique
  user         User             @relation(fields: [userId], references: [id])
  tier         SubscriptionTier @default(BASIC)
  isActive     Boolean          @default(true)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean    @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model ContactRevealed {
  id        String   @id @default(uuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  revealedAt DateTime @default(now())
}

model Property {
  id                  String         @id @default(uuid())
  title               String
  type                PropertyType
  status              PropertyStatus @default(VACANT)
  address             String
  thumbnailUrl        String?
  ownerId             String
  owner               User           @relation("PropertyOwner", fields: [ownerId], references: [id])
  managerId           String?
  manager             User?          @relation("PropertyManager", fields: [managerId], references: [id])
  monthlyRent         Int
  managementFeePercent Float         @default(10)
  leaseStart          DateTime?
  leaseEnd            DateTime?
  currentTenantId     String?
  inspections         PropertyInspection[]
  rentRecords         RentRecord[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model PropertyInspection {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  scheduledAt DateTime
  completedAt DateTime?
  notes       String?
  photoKeys   String[]
  geoLat      Float?
  geoLng      Float?
  createdAt   DateTime @default(now())
}

model RentRecord {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  month       Int
  year        Int
  amount      Int
  isPaid      Boolean  @default(false)
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  @@unique([propertyId, month, year])
}
